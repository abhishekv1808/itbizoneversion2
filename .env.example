# Contact form delivery (app/api/contact/route.js).
# Without these the form validates and responds, but returns a 503 and the
# enquiry is logged to the server console instead of being emailed.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Must be a sender on a domain you have verified in Resend.
# e.g. website@itbizone.com
CONTACT_FROM_EMAIL=

# Optional. Where enquiries land. Defaults to SITE.email (info@itbizone.com).
CONTACT_TO_EMAIL=


# Analytics — GA4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave empty and no gtag script loads at all, which is what keeps local and
# preview traffic out of the production property.
NEXT_PUBLIC_GA_ID=


# The real 15-minute Calendly event, e.g. https://calendly.com/itbizone/15min
# While this is empty every "Chat for 15 minutes" button routes to /contact
# rather than to a dead link, and its sub-label reads "Send us a brief".
NEXT_PUBLIC_CALENDLY_URL=


# Canonical origin, used by metadataBase, sitemap.xml, robots.txt and JSON-LD.
# Defaults to https://itbizone.com when unset.
NEXT_PUBLIC_SITE_URL=
